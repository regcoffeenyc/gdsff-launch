# Frontend API target
# Local development can use the default localhost backend.
# For live deployment, point this to your deployed API origin or same-origin backend host.
VITE_GDSFF_API_BASE=https://gdsff.org

# Vercel durable storage for membership registrations
# Create a private Blob store in the Vercel project and expose its token to the deployment.
BLOB_READ_WRITE_TOKEN=

# Shared federation mailbox
EMAIL_INBOX_ADDRESS=office@gdsff.org
EMAIL_OUTBOUND_ADDRESS=office@gdsff.org
EMAIL_MEMBERSHIP_NOTIFICATION_ADDRESS=metreveligod@gmail.com

# Stateless admin session signing for Vercel/serverless auth
ADMIN_SESSION_SECRET=

# Outgoing SMTP
# Primary GDSFF provider path: Titan
EMAIL_PROVIDER=titan
EMAIL_SMTP_HOST=smtp.titan.email
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Optional Gmail alternative:
# EMAIL_PROVIDER=gmail
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USERNAME=you@gmail.com
# EMAIL_SMTP_PASSWORD=your-app-password

# Inbox sync credentials are separate from outgoing SMTP.
# Use the IMAP keys below only for inbox sync, not for outbound membership delivery.
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
TITAN_IMAP_TLS=true
TITAN_IMAP_USERNAME=
TITAN_IMAP_PASSWORD=
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_SECURE=true
TITAN_SMTP_USERNAME=
TITAN_SMTP_PASSWORD=
